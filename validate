#!/usr/bin/env bash
set -Eeuo pipefail

PATH=$PATH:$(dirname "$0")/contrib/

list_xml_files() {
    local zip_file="$1"

    unzip -l "$zip_file" |
    sed --silent 's@^.* \([A-Za-z0-9_]\+\.xml\)$@\1@p' |
    sort -V
}

extract_as_utf8() {
    local zip_file="$1"
    local xml_file="$2"

    unzip -p "$zip_file" "$xml_file" |
    uconv -f UTF-16LE -t UTF-8
}

table_name_of_file_name() {
    local file="$1"

    shopt -s extglob
    echo "${file%%?(_*).*}"
}

# Extract the root element name from XML
get_xml_root() {
    local xml_content="$1"

    echo "$xml_content" |
    grep -oP '<\?xml.*?\?>\K<[^>/\s]+' |
    sed 's/^<//'
}

# Extract the child record element name from XML
get_xml_element() {
    local xml_content="$1"

    echo "$xml_content" |
    grep -oP '<\?xml.*?\?><[^>]+>\K<[^>/\s]+' |
    head -n 1 |
    sed 's/^<//'
}

# Extract all unique field names from XML
get_xml_fields() {
    grep -oP '<[^>/\s]*>' |
    sed 's/^<//;s/>$//' |
    sort -u
}

# Get root from schema
get_schema_root() {
    local schema_file="$1"

    jq -r '.root' "$schema_file"
}

# Get element from schema
get_schema_element() {
    local schema_file="$1"

    jq -r '.element' "$schema_file"
}

# Get all field names from schema
get_schema_fields() {
    local schema_file="$1"

    jq -r '.fields[].name' "$schema_file" | sort
}

validate_xml_file() {
    local zip_file="$1"
    local schema_dir="$2"
    local xml_file="$3"

    local table_name
    table_name=$(table_name_of_file_name "$xml_file")

    local schema_file="$schema_dir/$table_name.json"

    if [[ ! -f "$schema_file" ]]; then
        echo "ERROR: Schema file not found: $schema_file"
        return 1
    fi

    echo "Validating $xml_file against $table_name.json..."

    # Extract first 1KB for root/element validation
    local xml_header
    xml_header=$(extract_as_utf8 "$zip_file" "$xml_file" | head -c 1024)

    # Get XML structure from header
    local xml_root xml_element
    xml_root=$(get_xml_root "$xml_header")
    xml_element=$(get_xml_element "$xml_header")

    # Get schema structure
    local schema_root schema_element
    schema_root=$(get_schema_root "$schema_file")
    schema_element=$(get_schema_element "$schema_file")

    local validation_failed=0

    # Validate root element
    if [[ "$xml_root" != "$schema_root" ]]; then
        echo "  ✗ Root element mismatch: XML has '$xml_root', schema expects '$schema_root'"
        validation_failed=1
    else
        echo "  ✓ Root element: $xml_root"
    fi

    # Validate child element
    if [[ "$xml_element" != "$schema_element" ]]; then
        echo "  ✗ Child element mismatch: XML has '$xml_element', schema expects '$schema_element'"
        validation_failed=1
    else
        echo "  ✓ Child element: $xml_element"
    fi

    # Extract ENTIRE XML content for field validation (to catch rare properties)
    echo "  → Reading entire file to extract all field names..."
    local xml_fields
    xml_fields=$(extract_as_utf8 "$zip_file" "$xml_file" | \
                 get_xml_fields | \
                 grep -v "^$xml_root$" | grep -v "^$xml_element$")

    local schema_fields
    schema_fields=$(get_schema_fields "$schema_file")

    # Check for fields in XML but not in schema
    local missing_in_schema
    missing_in_schema=$(comm -23 <(echo "$xml_fields") <(echo "$schema_fields"))

    if [[ -n "$missing_in_schema" ]]; then
        echo "  ✗ Fields in XML but missing in schema:"
        echo "$missing_in_schema" | sed 's/^/      /'
        validation_failed=1
    fi

    # Check for fields in schema but not in XML
    local missing_in_xml
    missing_in_xml=$(comm -13 <(echo "$xml_fields") <(echo "$schema_fields"))

    if [[ -n "$missing_in_xml" ]]; then
        echo "  ✗ Fields in schema but missing in XML:"
        echo "$missing_in_xml" | sed 's/^/      /'
        validation_failed=1
    fi

    if [[ $validation_failed -eq 0 ]]; then
        echo "  ✓ All fields match ($(echo "$schema_fields" | wc -l) fields)"
        echo "  ✓ PASSED"
    else
        echo "  ✗ FAILED"
    fi

    echo ""

    return $validation_failed
}

# Required so `parallel` can run these functions.
export -f validate_xml_file
export -f extract_as_utf8
export -f table_name_of_file_name
export -f get_xml_root
export -f get_xml_element
export -f get_xml_fields
export -f get_schema_root
export -f get_schema_element
export -f get_schema_fields

options() {
    setup REST help:usage -- "Usage: $(basename "$0") [options]..."
    msg -- 'Options:'
    param ZIP_FILE    --zip-file    -- '(input) Markstammdatenregister zip file'
    param SCHEMA_DIR  --schema-dir  -- '(input) Directory containing schema JSON files'
    disp  :usage      --help
}

main() {
    eval "$(getoptions options) exit 1"
    local zip_file schema_dir
    zip_file="${ZIP_FILE}"
    schema_dir="${SCHEMA_DIR}"

    echo "Validating XML files from $zip_file against schemas in $schema_dir ..."

    local failed=0
    while IFS= read -r xml_file; do
        if ! validate_xml_file "$zip_file" "$schema_dir" "$xml_file"; then
            failed=$((failed + 1))
        fi
    done < <(list_xml_files "$zip_file")

    if [[ $failed -eq 0 ]]; then
        echo "All validations passed!"
    else
        echo "$failed file(s) failed validation"
        exit 1
    fi
}

main "$@"
